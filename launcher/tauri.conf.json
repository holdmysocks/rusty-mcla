{
  "productName": "RustyMCLA",
  "version": "0.8.0",
  "identifier": "org.rustymcla.launcher",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rusty MCLA",
        "width": 1280,
        "height": 760,
        "center": true,
        "decorations": false,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 380,
        "maximizable": false,
        "shadow": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
